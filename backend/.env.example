# Environment Configuration for TRACE

# LLM Provider Configuration
# Priority: OPENAI_API_KEY takes precedence over OPENROUTER_API_KEY
# If OPENAI_API_KEY is set, uses OpenAI (gpt-4o-mini)
# Otherwise falls back to OpenRouter

# OpenAI API Key (recommended - faster, more reliable)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# OpenRouter API Key (fallback option)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your-api-key-here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
